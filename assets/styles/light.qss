QWidget#OfficeShell, QStackedWidget#ShellPages, QWidget#ShellCanvas {
    background: #F5F7FB;
    color: #1E293B;
}
QScrollArea#ShellScroll { background: #F5F7FB; border: none; }
QFrame#ShellHeader { background: #FFFFFF; border-bottom: 1px solid #E2E8F0; }
QLabel[role] { background: transparent; color: #1E293B; font-size: 14px; }
QLabel[role="body"] { font-size: 14px; }
QLabel[role="muted"] { color: #667085; font-size: 14px; }
QLabel[role="caption"] { color: #778399; font-size: 12px; }
QLabel[role="eyebrow"] { color: #6B7280; font-size: 11px; font-weight: 700; }
QLabel[role="pageTitle"] { color: #172033; font-size: 31px; font-weight: 700; }
QLabel[role="cardTitle"] { color: #1E293B; font-size: 26px; font-weight: 700; }
QLabel[role="cardSubtitle"] { color: #475569; font-size: 14px; font-weight: 600; }
QLabel[role="sectionTitle"] { color: #334155; font-size: 15px; font-weight: 700; }
QLabel[role="breadcrumb"] { color: #334155; font-size: 13px; font-weight: 600; }
QLabel[role="headerMark"] { color: #7A8699; font-size: 10px; font-weight: 700; }
QLabel[role="footer"] { color: #8792A5; font-size: 10px; font-weight: 700; }
QLabel[role="keycap"] {
    color: #68758A; background: #F8FAFC; border: 1px solid #E2E8F0;
    border-radius: 6px; padding: 4px 8px; font-size: 11px;
}
QLabel[role="tag"] { color: #667085; font-size: 12px; }
QLabel[role="tag"][accent="blue"] { color: #5668CE; }
QLabel[role="tag"][accent="teal"] { color: #317F79; }
QLabel[role="iconTile"] { border-radius: 13px; background: #EEF2F7; }
QLabel[role="iconTile"][tone="blue"] { background: #EEF1FF; }
QLabel[role="iconTile"][tone="teal"] { background: #EAF7F5; }
QLabel[role="badge"] {
    background: #FFF6DF; color: #806124; border-radius: 6px;
    padding: 6px 10px; font-size: 12px; font-weight: 600;
}
QLabel[role="success"] { color: #0F8F87; font-size: 13px; }
QLabel[role="error"] { color: #B23A48; font-size: 13px; }
QFrame[role="appCard"], QFrame[role="panel"] {
    background: #FFFFFF; border: 1px solid #DFE5EF; border-radius: 16px;
}
QFrame[role="appCard"][accent="blue"]:hover { border: 1px solid #A8B3F5; }
QFrame[role="appCard"][accent="teal"]:hover { border: 1px solid #A9D9D4; }
QFrame[role="settingsBanner"] {
    background: #FFFFFF; border: 1px solid #E2E8F0; border-radius: 12px;
}
QPushButton[role="primary"] {
    background: #4F63E8; color: #FFFFFF; border: 2px solid transparent;
    border-radius: 8px; font-size: 13px; font-weight: 700; padding: 6px 18px;
}
QPushButton[role="primary"]:hover { background: #4053D1; }
QPushButton[role="primary"]:pressed { background: #3546B8; }
QPushButton[role="primary"]:focus { border: 2px solid #B9C2FF; }
QPushButton[role="primary"][accent="teal"] { background: #0F8F87; }
QPushButton[role="primary"][accent="teal"]:hover { background: #0B766F; }
QPushButton[role="primary"][accent="teal"]:pressed { background: #08625D; }
QPushButton[role="primary"][accent="teal"]:focus { border: 2px solid #A4DDD8; }
QPushButton[role="secondary"] {
    background: #FFFFFF; color: #42526A; border: 1px solid #D6DEE9;
    border-radius: 8px; font-size: 12px; font-weight: 600; padding: 6px 15px;
}
QPushButton[role="secondary"]:hover { background: #F4F6FB; border-color: #BFC9D8; }
QPushButton[role="secondary"]:pressed { background: #EBEFF6; }
QPushButton[role="secondary"]:focus { border: 1px solid #4F63E8; }
QFrame#Sidebar { background: #162033; }
QFrame#SidebarDivider { background: #2A3750; border: none; }
QLabel[role="brand"] { color: #F8FAFC; font-size: 20px; font-weight: 800; }
QLabel[role="brandSubtitle"] { color: #94A3B8; font-size: 10px; }
QLabel[role="navCaption"] { color: #8796AD; font-size: 10px; font-weight: 700; }
QPushButton[role="nav"] {
    background: transparent; color: #C1CCDC; border: 1px solid transparent;
    border-radius: 8px; text-align: left; padding: 0 14px; font-size: 13px;
}
QPushButton[role="nav"]:hover { background: #202D45; color: #FFFFFF; }
QPushButton[role="nav"]:checked { background: #293B59; color: #FFFFFF; font-weight: 700; }
QPushButton[role="nav"]:focus { border: 1px solid #657A9A; }
QComboBox#startPageCombo, QComboBox#themeCombo {
    background: #FFFFFF; color: #334155; border: 1px solid #CBD5E1;
    border-radius: 8px; padding: 6px 12px; font-size: 14px;
}
QComboBox#startPageCombo:focus, QComboBox#themeCombo:focus { border: 1px solid #4F63E8; }
QComboBox#startPageCombo QAbstractItemView, QComboBox#themeCombo QAbstractItemView {
    background: #FFFFFF; color: #334155; selection-background-color: #EEF1FF;
    selection-color: #3E4EB4; padding: 4px;
}
QCheckBox#rememberWindow { color: #334155; font-size: 14px; spacing: 10px; }
QScrollBar:vertical { background: transparent; width: 10px; margin: 4px 2px; }
QScrollBar::handle:vertical { background: #C5D0DE; border-radius: 4px; min-height: 38px; }
QScrollBar::handle:vertical:hover { background: #AEBBCB; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; border: none; }
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { background: transparent; }
QScrollBar:horizontal { background: transparent; height: 10px; margin: 2px 4px; }
QScrollBar::handle:horizontal { background: #C5D0DE; border-radius: 4px; min-width: 38px; }
QScrollBar::handle:horizontal:hover { background: #AEBBCB; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; border: none; }
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal { background: transparent; }
QScrollBar::corner { background: transparent; }
