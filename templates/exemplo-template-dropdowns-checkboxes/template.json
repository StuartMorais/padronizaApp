{
  "template": {
    "id": "exemplo-template-dropdowns-checkboxes",
    "name": "Exemplo Template Dropdowns Checkboxes",
    "description": "",
    "category": "",
    "version": "1.0",
    "source_file": "template.docx",
    "adapter": "docx"
  },
  "fields": [
    {
      "id": "company.legal_name",
      "label": "Company Legal Name",
      "type": "text",
      "required": true,
      "profile_key": "company.legal.name",
      "section": "Company / Supplier"
    },
    {
      "id": "company.cnpj",
      "label": "Company Cnpj",
      "type": "cnpj",
      "required": true,
      "profile_key": "company.cnpj",
      "section": "Company / Supplier"
    },
    {
      "id": "process.number",
      "label": "Process Number",
      "type": "text",
      "required": true,
      "section": "Process / Contract"
    },
    {
      "id": "process.modality",
      "label": "Process Modality",
      "type": "dropdown",
      "required": true,
      "options": [
        "Pregão Eletrônico",
        "Concorrência",
        "Dispensa",
        "Inexigibilidade"
      ],
      "section": "Process / Contract"
    },
    {
      "id": "company.size",
      "label": "Company Size",
      "type": "dropdown",
      "required": true,
      "options": [
        "ME",
        "EPP",
        "Demais Empresas"
      ],
      "profile_key": "company.size",
      "section": "Company / Supplier"
    },
    {
      "id": "declaration.accepted",
      "label": "Declaration Accepted",
      "type": "checkbox",
      "required": false,
      "section": "Address"
    },
    {
      "id": "declaration.documents_complete",
      "label": "Declaration Documents Complete",
      "type": "checkbox",
      "required": false,
      "section": "Document"
    },
    {
      "id": "declaration.no_impediment",
      "label": "Declaration No Impediment",
      "type": "checkbox",
      "required": false,
      "section": "Document Data"
    },
    {
      "id": "declaration.notes",
      "label": "Declaration Notes",
      "type": "multiline",
      "required": true,
      "section": "Document Data"
    },
    {
      "id": "document.city",
      "label": "Document City",
      "type": "text",
      "required": true,
      "section": "Address"
    },
    {
      "id": "document.date",
      "label": "Document Date",
      "type": "date",
      "required": true,
      "automatic": true,
      "section": "Document"
    },
    {
      "id": "representative.name",
      "label": "Representative Name",
      "type": "text",
      "required": true,
      "section": "Document Data"
    },
    {
      "id": "representative.role",
      "label": "Representative Role",
      "type": "text",
      "required": true,
      "section": "Document Data"
    }
  ],
  "sections": [
    {
      "title": "Company / Supplier",
      "fields": [
        "company.legal_name",
        "company.cnpj",
        "company.size"
      ]
    },
    {
      "title": "Process / Contract",
      "fields": [
        "process.number",
        "process.modality"
      ]
    },
    {
      "title": "Address",
      "fields": [
        "declaration.accepted",
        "document.city"
      ]
    },
    {
      "title": "Document",
      "fields": [
        "declaration.documents_complete",
        "document.date"
      ]
    },
    {
      "title": "Document Data",
      "fields": [
        "declaration.no_impediment",
        "declaration.notes",
        "representative.name",
        "representative.role"
      ]
    }
  ],
  "output": {
    "filename_pattern": "{{template.name}}.docx",
    "folder_pattern": ""
  },
  "numbering": {
    "enabled": false,
    "key": "exemplo-template-dropdowns-checkboxes",
    "padding": 4
  }
}
