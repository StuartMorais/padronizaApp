{
  "include": [
    "app/domain",
    "app/services",
    "app/core/atomic_output.py",
    "app/core/json_io.py",
    "app/core/schema.py",
    "app/repositories/local_data.py",
    "app/repositories/field_library.py"
  ],
  "exclude": [
    "**/__pycache__",
    ".venv",
    "build",
    "dist",
    "release"
  ],
  "pythonVersion": "3.12",
  "typeCheckingMode": "basic",
  "reportMissingTypeStubs": "none",
  "reportPrivateUsage": "none",
  "reportUnusedImport": "none",
  "reportUnusedVariable": "none"
}
